# Muse isolated Discord gateway - NON-SECRET config (env-only, no config file)
# Secrets: DISCORD_BOT_TOKEN_FILE is set only after the owner provides the token.
BRIDGE_DB=/home/hatch/workspace/discord-gateway/state/bridge.sqlite3
BRIDGE_HTTPS_PROXY=http://hatch-egress-proxy:3128
# PLACEHOLDER owner/bot IDs - replace with real Discord snowflakes before go-live.
DISCORD_OWNER_ID=337961354847846401
DISCORD_ALLOWED_DM_IDS=337961354847846401
DISCORD_EXPECTED_BOT_ID=1528396024492593324
DISCORD_GUILD_ID=1555638956727468124
DISCORD_GUILD_CHANNEL_ID=1555638957755343052
DISCORD_GUILD_MODE=all
DISCORD_ENABLE_MESSAGE_CONTENT=true
# Outbound script allowlist: bin/send-channel.sh refuses any channel not listed
# here. Space-separated Discord channel IDs. Extend when the bot serves more
# channels/servers.
DISCORD_SEND_ALLOWLIST="1555638957755343052 1555779998701322343 1556155819626602547"
